-class EdgeTable:
-    """Per-edge scalars in id order: ``values[k]`` belongs to edge ``k + 1``."""
-
-    def __init__(self, values):
-        self.values = values
-        self.n = len(next(iter(values.values())))
-
-    def __getitem__(self, key):
-        return self.values[key]
